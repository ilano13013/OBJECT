# OBJECT. — environment variables
# Copy to .env.local for local development. Never commit real values.
#
# Phase A (landing + demos) needs NO variables.

# ── Phase C · Supabase (public, safe for the browser; RLS protects data) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Phase C/D · server-side only (Vercel functions). NEVER prefix with VITE_ ──
SUPABASE_SERVICE_ROLE_KEY=

# ── Phase D · Stripe, TEST MODE keys only until launch is authorised ──
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_ONE=price_
STRIPE_PRICE_STUDIO=price_
# Public site URL used for Checkout success/cancel redirects
APP_URL=http://localhost:5173
