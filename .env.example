# OBJECT. — environment variables
# Copy to .env.local for local development. Never commit real values.
#
# Without the two VITE_SUPABASE_* values the site runs in local mode
# (no accounts, showrooms stored in the browser). See docs/SUPABASE.md.

# ── Supabase (public, safe for the browser; RLS protects data) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-side only (Vercel Functions in /api). NEVER prefix with VITE_ ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe, TEST MODE keys only until launch is authorised (see docs/STRIPE.md) ──
# The server refuses sk_live_ keys unless ALLOW_LIVE_PAYMENTS=true.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_ONE=price_
STRIPE_PRICE_STUDIO=price_
# Public site URL used for Checkout success/cancel redirects
APP_URL=http://localhost:5173
# Set to true in the browser build once live payments are authorised (hides the test-mode notice)
VITE_PAYMENTS_LIVE=false

# ── Tripo AI (photo → 3D), server only — NEVER prefix with VITE_ (see docs/TRIPO.md) ──
TRIPO_API_KEY=
# Optional overrides
# TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi
# TRIPO_MODEL_VERSION=v3.1-20260211
